{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "takudev-works の repo に共通の Renovate の設定",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "schedule": ["before 9am every weekday"],
  "timezone": "Asia/Tokyo",
  "assignees": ["t-i-0414"],
  "commitMessagePrefix": "chore:",
  "minimumReleaseAge": "7 days",
  "rangeStrategy": "bump",
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on Monday"]
  },
  "packageRules": [
    {
      "description": "mise の op（1Password CLI）は aqua の http 型パッケージで、Renovate は mise の aqua backend を github-tags と解釈するため必ず no-result になる。配信元に対応する GitHub リポジトリが無く、参照できる datasource が無い。バージョンは手動で上げる。",
      "matchManagers": ["mise"],
      "matchDepNames": ["op"],
      "enabled": false
    },
    {
      "description": "typescript-eslint の peerDependencies が typescript >=4.8.4 <6.1.0 で、それより新しい TS では lint が落ちる。typescript-eslint が対応したら上限を上げる。TypeScript は dev-config の依存なので、どの repo にも効くようにここに置く。",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "npm dependencies (non-major)",
      "groupSlug": "npm-deps-non-major"
    },
    {
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "python dependencies (non-major)",
      "groupSlug": "python-deps-non-major"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "github actions (non-major)",
      "groupSlug": "github-actions-non-major"
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "mise tools (non-major)",
      "groupSlug": "mise-tools-non-major"
    },
    {
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "terraform (non-major)",
      "groupSlug": "terraform-non-major"
    },
    {
      "description": "rangeStrategy が bump なので、Terraform の本体が上がると required_version も上がる。mise の Terraform（depName は terraform）だけ mise tools の PR に分かれると、required_version を上げた PR の CI が古い Terraform で動いて落ちる。mise の Terraform を terraform の PR に入れて、1 本の PR で上げる。",
      "matchManagers": ["mise"],
      "matchDepNames": ["terraform"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "terraform (non-major)",
      "groupSlug": "terraform-non-major"
    },
    {
      "description": "takudev-works の共通設定は自分たちで出すので、公開から日を置かずに上げる。package.json の版と、再利用できるワークフローの呼び出し先（depName は takudev-works/dev-config）を 1 本の PR で上げる。",
      "matchDepNames": ["@takudev-works/dev-config", "takudev-works/dev-config"],
      "groupName": "dev-config",
      "groupSlug": "dev-config",
      "minimumReleaseAge": null
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"]
  }
}
