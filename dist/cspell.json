{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "globRoot": "${cwd}",
  "enableGlobDot": true,
  "useGitignore": true,
  "ignorePaths": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/venv/**",
    "**/vendor/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/.output/**",
    "**/coverage/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/.mypy_cache/**",
    "**/.ruff_cache/**",
    "**/.expo/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/.ruby-lsp/**",
    "**/.terraform/**",
    "**/.vercel/**",
    "**/.git/**",
    "**/pnpm-lock.yaml",
    "**/uv.lock",
    "**/package-lock.json",
    "**/.terraform.lock.hcl",
    "**/.gitignore"
  ],
  "ignoreRegExpList": [
    "/\\p{Script=Hiragana}+/gu",
    "/\\p{Script=Katakana}+/gu",
    "/\\p{Script=Han}+/gu",
    "/[\\u3000-\\u303f]+/gu"
  ],
  "words": [
    "anthropics",
    "artipacked",
    "Canva",
    "commitlint",
    "commitlintrc",
    "cspell",
    "doublestar",
    "elif",
    "esac",
    "frontmatter",
    "Inoreader",
    "iwashiro",
    "lefthook",
    "libpq",
    "markdownlint",
    "monorepo",
    "mypy",
    "npmpackagejsonlintrc",
    "pipefail",
    "pycache",
    "pytest",
    "refino",
    "secretlint",
    "secretlintignore",
    "secretlintrc",
    "shellcheck",
    "Taku",
    "takudev",
    "Takuya",
    "textlint",
    "textlintignore",
    "textlintrc",
    "tfvars",
    "vcpu",
    "venv",
    "vercel",
    "vitest",
    "worktree",
    "zizmor"
  ]
}
