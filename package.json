{
  "name": "@takudev-works/dev-config",
  "version": "9.0.0",
  "private": true,
  "description": "takudev-works の各 repo で共通に使う開発の設定と CI のワークフローの正本",
  "license": "MIT",
  "bin": {
    "dev-config": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mts",
    "validate": "run-p validate:*",
    "validate:build": "node scripts/check-build.mts",
    "validate:format": "prettier --check .",
    "validate:lint": "eslint .",
    "validate:markdown": "markdownlint-cli2 \"**/*.md\"",
    "validate:package-json": "node dist/cli.mjs npm-package-json-lint \"**/package.json\"",
    "validate:secrets": "node dist/cli.mjs secretlint \"**/*\"",
    "validate:spell": "cspell --no-progress \"**\"",
    "validate:test": "vitest run --coverage",
    "validate:text": "node dist/cli.mjs textlint \"**/*.md\"",
    "validate:type": "tsc",
    "validate:workflows": "node dist/cli.mjs actionlint && node dist/cli.mjs zizmor .github/workflows"
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@vitest/coverage-v8": "5.0.5",
    "cspell": "^10.4.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "markdownlint-cli2": "^0.23.3",
    "npm-package-json-lint": "^11.0.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "secretlint": "^13.0.7",
    "textlint": "^15.8.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-prh": "^6.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "5.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  },
  "packageManager": "pnpm@12.14.0",
  "prettier": "./src/prettier/prettierrc.json"
}
