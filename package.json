{
  "name": "dev-config",
  "version": "4.1.0",
  "private": true,
  "description": "Takudev の lint 設定の正本",
  "license": "MIT",
  "files": [
    "base.commitlintrc.json",
    "base.cspell.json",
    "base.eslint.config.mjs",
    "base.markdownlint-cli2.jsonc",
    "base.npmpackagejsonlintrc.json",
    "base.prettierrc.json",
    "base.renovate.json",
    "base.secretlintignore",
    "base.secretlintrc.json",
    "base.tsconfig.json",
    "base.vitest.config.d.mts",
    "base.vitest.config.mjs"
  ],
  "scripts": {
    "validate": "run-p validate:*",
    "validate:format": "prettier --check .",
    "validate:lint": "eslint .",
    "validate:markdown": "markdownlint-cli2 --config base.markdownlint-cli2.jsonc \"**/*.md\"",
    "validate:package-json": "npmPkgJsonLint --configFile base.npmpackagejsonlintrc.json \"**/package.json\"",
    "validate:secrets": "secretlint --secretlintrc base.secretlintrc.json --secretlintignore base.secretlintignore \"**/*\"",
    "validate:spell": "cspell --no-progress \"**\""
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
    "@vitest/coverage-v8": "4.1.11",
    "cspell": "^10.3.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "markdownlint-cli2": "^0.23.3",
    "npm-package-json-lint": "^11.0.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "secretlint": "^13.0.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "prettier": "./base.prettierrc.json"
}
