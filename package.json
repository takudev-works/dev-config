{
  "name": "dev-config",
  "version": "5.6.2",
  "private": true,
  "description": "takudev-works の各 repo で共通に使う開発の設定と CI のワークフローの正本",
  "license": "MIT",
  "files": [
    "src"
  ],
  "scripts": {
    "validate": "run-p validate:*",
    "validate:format": "prettier --check .",
    "validate:lint": "eslint .",
    "validate:markdown": "markdownlint-cli2 --config src/markdownlint-cli2.jsonc \"**/*.md\"",
    "validate:package-json": "npmPkgJsonLint --configFile src/npmpackagejsonlintrc.json \"**/package.json\"",
    "validate:secrets": "secretlint --secretlintrc src/secretlintrc.json --secretlintignore src/secretlintignore \"**/*\"",
    "validate:spell": "cspell --no-progress \"**\"",
    "validate:text": "textlint --config src/textlintrc.json --ignore-path src/textlintignore \"**/*.md\"",
    "validate:type": "tsc"
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@vitest/coverage-v8": "5.0.4",
    "cspell": "^10.3.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "markdownlint-cli2": "^0.23.3",
    "npm-package-json-lint": "^11.0.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "secretlint": "^13.0.7",
    "textlint": "^15.8.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-prh": "^6.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "5.0.4"
  },
  "prettier": "./src/prettierrc.json"
}
